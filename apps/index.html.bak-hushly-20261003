*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.65 -apple-system,"Malgun Gothic",system-ui,sans-serif;word-break:keep-all}
.wrap{max-width:1080px;margin:0 auto;padding:40px 20px 80px}
header h1{font-size:30px;margin:0 0 6px;letter-spacing:-.5px}
header p.sub{color:var(--sub);margin:0 0 4px;font-size:17px}
header p.desc{color:var(--sub);margin:10px 0 0;font-size:14px;max-width:60ch}
nav.langs{display:flex;gap:9px;margin:20px 0 0}
nav.langs a{display:inline-flex;align-items:center;padding:9px 20px;border-radius:999px;border:1.5px solid var(--acc);color:var(--acc);text-decoration:none;font-weight:800;font-size:14px;transition:.15s}
nav.langs a:hover{background:rgba(75,86,184,.08)}
nav.langs a.on{background:var(--acc);color:#fff;box-shadow:0 3px 10px rgba(75,86,184,.28)}
h2{font-size:15px;color:var(--sub);margin:34px 0 12px;text-transform:uppercase;letter-spacing:.6px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px}
.app{display:flex;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px}
.app img{border-radius:14px;flex:none;width:64px;height:64px;object-fit:cover}
.app h3{margin:0 0 4px;font-size:16px}
.app p{margin:0;color:var(--sub);font-size:13.5px}
.q{margin:9px 0 0;font-size:12px;color:var(--sub)}
.q span{font-weight:800;opacity:.75;display:block;margin-bottom:3px}
.q em{display:inline-block;font-style:normal;background:rgba(75,86,184,.09);color:var(--acc);
      border-radius:999px;padding:2px 9px;margin:2px 4px 0 0;font-size:11.5px}
.cta{display:inline-flex;align-items:center;gap:7px;margin-top:14px;background:var(--acc);color:#fff;font-size:13.5px;font-weight:800;text-decoration:none;border-radius:11px;padding:11px 18px;box-shadow:0 3px 10px rgba(75,86,184,.28);transition:transform .12s,box-shadow .12s,background .12s}
.cta:hover{background:#3d47a6;box-shadow:0 5px 16px rgba(75,86,184,.42);transform:translateY(-1px)}
.cta::before{content:"▶";font-size:10px;line-height:1}
.ans{display:flex;flex-wrap:wrap;gap:8px}
.ans a{background:var(--card);border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13px;color:var(--ink);text-decoration:none}
.ans a:hover{border-color:var(--acc);color:var(--acc)}
.catbar{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 6px;position:sticky;top:0;background:var(--bg);padding:12px 0;z-index:5}
.chip{cursor:pointer;font-family:inherit;font-size:13.5px;font-weight:800;border-radius:999px;padding:9px 17px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);transition:.15s}
.chip:hover{border-color:var(--acc);color:var(--acc)}
.chip.on{background:var(--acc);color:#fff;border-color:var(--acc);box-shadow:0 3px 10px rgba(75,86,184,.28)}
.catsec{scroll-margin-top:70px}
.cathead{display:flex;align-items:center;gap:11px;font-size:20px;font-weight:800;color:var(--ink);text-transform:none;letter-spacing:-.3px;margin:40px 0 16px;padding-left:14px;border-left:5px solid var(--acc)}
.cathead .count{font-size:12.5px;font-weight:800;color:#fff;background:var(--acc);border-radius:999px;padding:2px 10px}
footer{margin-top:56px;color:var(--sub);font-size:12.5px;border-top:1px solid var(--line);padding-top:18px}
